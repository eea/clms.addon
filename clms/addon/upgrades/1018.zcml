<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    >

  <gs:upgradeSteps
      profile="clms.addon:default"
      source="1017"
      destination="1018"
      >

    <gs:upgradeStep
        title="Limit idle REST API sessions"
        description="Expire JWTs after 30 minutes without activity"
        handler=".v1018.upgrade"
        />

  </gs:upgradeSteps>

</configure>
