<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    >

  <gs:upgradeSteps
      profile="clms.addon:default"
      source="1015"
      destination="1016"
      >

    <gs:upgradeStep
        title="Enable server-side JWT storage"
        description="Store JWTs server-side and reduce their lifetime to one hour"
        handler=".v1016.upgrade"
        />

  </gs:upgradeSteps>

</configure>
