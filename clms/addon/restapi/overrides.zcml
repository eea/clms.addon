<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <include
      package=".richtext_serializer_deserializer"
      file="overrides.zcml"
      />

  <plone:service
      method="POST"
      factory=".login_renew.post.Renew"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="zope.Public"
      name="@login-renew"
      />

</configure>
