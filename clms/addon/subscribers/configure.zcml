<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="eea"
    >

  <subscriber
      for="plone.app.contenttypes.interfaces.IDocument
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".hide_public_folder_in_events.set_folder_expired"
      />

  <subscriber
      for="plone.app.contenttypes.interfaces.IFolder
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".hide_public_folder_in_events.set_folder_expired"
      />


  <subscriber
      for="*
           Products.PluggableAuthService.interfaces.events.ICredentialsUpdatedEvent"
      handler=".token_revocation.revoke_tokens_on_credentials_updated"
      />

  <subscriber
      for="*
           Products.PluggableAuthService.interfaces.events.IPrincipalDeletedEvent"
      handler=".token_revocation.revoke_tokens_on_principal_deleted"
      />

</configure>
